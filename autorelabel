#!/usr/bin/env bash
# autorelabel: the one command. Bootstraps a private Python environment on first
# run, then hands over to the app (TUI by default, CLI with arguments).
#
#   ./autorelabel              open the TUI
#   ./autorelabel rhcsa        start a new RHCSA exam
#   ./autorelabel uninstall    remove everything autorelabel created on this host
#   ./autorelabel --help       list all commands
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)"
VENV="$ROOT/.venv"
LOCK="$ROOT/requirements.lock"
MARKER="$VENV/.autorelabel-ready"
MIN_PY_MINOR=10

if [[ -t 2 ]]; then
  C_RED=$'\e[1;31m' C_YEL=$'\e[1;33m' C_GRN=$'\e[1;32m' C_DIM=$'\e[2m' C_OFF=$'\e[0m'
else
  C_RED='' C_YEL='' C_GRN='' C_DIM='' C_OFF=''
fi
say()  { printf '%s\n' "${C_DIM}autorelabel:${C_OFF} $*" >&2; }
warn() { printf '%s\n' "${C_YEL}autorelabel:${C_OFF} $*" >&2; }
die()  { printf '%s\n' "${C_RED}autorelabel: error:${C_OFF} $*" >&2; exit 1; }

# --- Platform gate (v1 supports Linux x86_64 hosts only) ---------------------
check_platform() {
  local os arch
  os="$(uname -s)"; arch="$(uname -m)"
  if [[ "$os" != "Linux" ]]; then
    die "this version supports Linux hosts only (detected: $os).
       Windows and macOS are not supported in v1. Windows support is planned for v2."
  fi
  if [[ -n "${WSL_DISTRO_NAME:-}" ]] || grep -qiE 'microsoft|wsl' /proc/sys/kernel/osrelease 2>/dev/null; then
    die "WSL is not supported (nested virtualization and networking are unreliable).
       Run autorelabel on a native Linux host. Windows support is planned for v2."
  fi
  if [[ "$arch" != "x86_64" ]]; then
    die "an x86_64 host is required (detected: $arch). RHEL 10 x86_64 labs need an x86-64-v3 CPU."
  fi
}

# --- Python discovery ----------------------------------------------------------
find_python() {
  local candidates=("${AUTORELABEL_PYTHON:-}" python3.14 python3.13 python3.12 python3.11 python3.10 python3)
  local py
  for py in "${candidates[@]}"; do
    [[ -n "$py" ]] || continue
    command -v "$py" >/dev/null 2>&1 || continue
    if "$py" -c "import sys; sys.exit(0 if sys.version_info >= (3, $MIN_PY_MINOR) else 1)" 2>/dev/null; then
      command -v "$py"; return 0
    fi
  done
  return 1
}

distro_hint() {
  # Print the package that provides venv/ensurepip for the detected distro.
  local id="" like="" ver
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    id="$(. /etc/os-release; echo "${ID:-}")"
    # shellcheck disable=SC1091
    like="$(. /etc/os-release; echo "${ID_LIKE:-}")"
  fi
  ver="$("$1" -c 'import sys; print(f"{sys.version_info[0]}.{sys.version_info[1]}")' 2>/dev/null || echo 3)"
  case " $id $like " in
    *" debian "*|*" ubuntu "*) echo "sudo apt install python3-venv   (or: sudo apt install python${ver}-venv)";;
    *" fedora "*|*" rhel "*|*" centos "*) echo "sudo dnf install python3";;
    *" arch "*) echo "sudo pacman -S python";;
    *" suse "*|*" opensuse "*) echo "sudo zypper install python3";;
    *) echo "install your distribution's python3 'venv' package";;
  esac
}

lock_digest() {
  { sha256sum "$LOCK" | cut -d' ' -f1; "$1" -c 'import sys; print(sys.version)'; } | sha256sum | cut -d' ' -f1
}

ensure_venv() {
  local py="$1" want have=""
  want="$(lock_digest "$py")"
  [[ -f "$MARKER" ]] && have="$(cat "$MARKER" 2>/dev/null || true)"
  [[ -x "$VENV/bin/python" && "$want" == "$have" ]] && return 0

  if ! "$py" -c 'import venv, ensurepip' >/dev/null 2>&1; then
    die "Python's 'venv' module is missing. Install it, then re-run ./autorelabel:
       $(distro_hint "$py")"
  fi

  say "setting up the private Python environment (first run, ~30 s)..."
  rm -rf -- "$VENV"
  "$py" -m venv "$VENV" || { rm -rf -- "$VENV"; die "could not create $VENV"; }

  export PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_INPUT=1
  local attempt
  for attempt in 1 2 3; do
    if "$VENV/bin/python" -m pip install --quiet --require-hashes --no-deps -r "$LOCK"; then
      printf '%s\n' "$want" > "$MARKER"
      say "${C_GRN}Python environment ready.${C_OFF}"
      return 0
    fi
    warn "dependency download failed (attempt $attempt/3); retrying in $((attempt * 5)) s..."
    sleep $((attempt * 5))
  done
  rm -rf -- "$VENV"
  die "could not install Python dependencies from PyPI. Check your internet connection and re-run."
}

main() {
  check_platform

  # Uninstall must work even when Python or the venv is broken.
  if [[ "${1:-}" == "uninstall" ]]; then
    shift
    exec bash "$ROOT/scripts/uninstall.sh" "$@"
  fi

  local py
  py="$(find_python)" || die "Python 3.$MIN_PY_MINOR or newer is required but was not found.
       Install python3 with your package manager, then re-run ./autorelabel."
  ensure_venv "$py"

  export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
  export PYTHONPYCACHEPREFIX="$ROOT/.workspace/pycache"
  export AUTORELABEL_ROOT="$ROOT"
  exec "$VENV/bin/python" -m autorelabel "$@"
}

main "$@"
