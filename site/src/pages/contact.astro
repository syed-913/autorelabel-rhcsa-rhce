---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import {canonical,repository} from '../lib/urls';
import {author} from '../lib/project';
const places=[
  ['A bug or an error message',`${repository}/issues/new?template=problem-report.yml`,'Report a problem ↗','Attach the report from `./autorelabel report`: it hides your user name, host name and passwords.'],
  ['A task that is wrong or unclear',`${repository}/issues/new?template=task-feedback.yml`,'Send task feedback ↗','Name the task and what you expected. Every task is fixed and tested again before it ships.'],
  ['A question others may have too',`${repository}/discussions`,'Ask in Discussions ↗','The answer stays there for the next person with the same question.'],
  ['A security problem',`${repository}/security/advisories/new`,'Report it privately ↗','Only the maintainer sees it. Please don’t post it in public.'],
];
// The same lists as the Worker that takes the form: anything else arrives as the default.
const topics=['A question','An idea or feedback','My exam result','A problem with autorelabel','Supporting autorelabel','Something else'];
const exams=[['','Not about one exam'],['rhcsa','RHCSA (EX200)'],['rhce','RHCE (EX294)'],['both','Both']];
const schema={'@context':'https://schema.org','@type':'ContactPage',name:'Contact autorelabel',url:canonical('/contact/'),about:{'@type':'SoftwareApplication',name:'autorelabel',url:canonical('/')},author:{'@type':'Person',name:author.name,url:author.url}};
---
<Layout title="Contact" description="Write to the author of autorelabel, the free RHCSA and RHCE practice exam simulator. Bugs, task problems and security reports have their own place on GitHub." path="/contact/" schema={schema}>
<main id="content" class="container reading-page contact-page">
  <div class="page-intro"><h1>Write to<br/><em>the author.</em></h1><p>A question, an idea, your exam result, or a way to support autorelabel: one message reaches the person who builds it.</p></div>
  <section class="page-section" id="message"><h2>Send a message.</h2>
    <p class="measure">Only the message is needed. Nothing here asks who you are: add a GitHub username or an email address only if you’d like an answer.</p>
    <form class="contact-form" method="post" data-contact-form>
      <div class="contact-form__row">
        <div class="contact-form__field"><label for="contact-topic">What it’s about</label><select id="contact-topic" name="topic">{topics.map(topic=><option>{topic}</option>)}</select></div>
        <div class="contact-form__field"><label for="contact-exam">Exam <span>optional</span></label><select id="contact-exam" name="exam">{exams.map(([value,label])=><option value={value}>{label}</option>)}</select></div>
      </div>
      <div class="contact-form__field"><label for="contact-message">Message</label><textarea id="contact-message" name="message" rows="8" maxlength="3000" required></textarea></div>
      <div class="contact-form__row">
        <div class="contact-form__field"><label for="contact-github">GitHub username <span>optional</span></label><input id="contact-github" name="github" type="text" maxlength="40" pattern="@?[A-Za-z0-9\-]{1,39}" title="A GitHub username: letters, digits and hyphens" autocomplete="off" autocapitalize="off" spellcheck="false"/></div>
        <div class="contact-form__field"><label for="contact-reply">Email for a reply <span>optional</span></label><input id="contact-reply" name="reply" type="email" maxlength="254" autocomplete="email" spellcheck="false"/></div>
      </div>
      <div class="contact-form__trap" aria-hidden="true"><label for="contact-website">Leave this empty</label><input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off"/></div>
      <div class="contact-form__send"><button type="submit" class="btn" data-cursor="send">Send message <Icon name="arrow"/></button><p class="contact-form__status" role="status" data-form-status></p></div>
    </form>
    <noscript><p class="measure">The form needs JavaScript. The address below works without it.</p></noscript>
  </section>
  <section class="page-section" id="email"><h2>Email.</h2>
    <div class="contact-address"><a class="contact-address__link" id="contact-address" data-mail-user="contact" data-mail-domain="autorelabel.dpdns.org">contact (at) autorelabel.dpdns.org</a><button type="button" class="copy-button" data-copy-target="contact-address" aria-label="Copy the email address" data-cursor="copy"><Icon name="copy"/><span data-copy-label>Copy</span></button></div>
    <p class="measure">Prefer your own mail app? Write to this address. Replies come by email.</p>
  </section>
  <section class="page-section" id="elsewhere"><h2>Some things have<br/>a better place.</h2>
    <dl class="file-ledger contact-places">{places.map(([what,url,label,note])=><div><dt>{what}</dt><dd><a class="text-link" href={url}>{label}</a><span set:html={note.replace(/`([^`]+)`/g,'<code>$1</code>')}/></dd></div>)}</dl>
  </section>
  <section class="page-section" id="author"><h2>Who makes autorelabel.</h2><p class="measure">autorelabel is built and maintained by {author.name}. More of {author.name}’s work is at <a class="text-link" href={author.url}>{author.url.replace('https://','')} ↗</a>.</p></section>
</main>
</Layout>
