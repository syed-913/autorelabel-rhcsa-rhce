---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import {tasks,counts,domains,objectiveText} from '../lib/content';
import {href} from '../lib/urls';
const difficultyCounts=Object.fromEntries(['easy','medium','hard'].map(level=>[level,tasks.filter(t=>t.difficulty===level).length]));
---
<Layout title="The task bank" description={`Browse all ${counts.total} autorelabel task titles and objective lines. Filter by exam, domain, difficulty and practice eligibility.`} path="/tasks/">
<main id="content" class="container" data-task-bank>
  <section class="task-bank-head"><div><h1>The task bank.</h1><p>Every task, and every objective it covers.<br/>An exam draws 20 of them; in practice mode you pick.</p></div><div class="bank-total"><b>{counts.total} tasks / {counts.eligible} exam-eligible</b><br/>{counts.rhcsa} RHCSA · {counts.rhce} RHCE · {counts.practice} practice-only</div></section>
  <form data-bank-form>
  <div class="bank-toolbar"><div class="bank-tabs" role="group" aria-label="Exam filter">{[['all','All tasks',counts.total],['rhcsa','RHCSA',counts.rhcsa],['rhce','RHCE',counts.rhce]].map(([value,label,count])=><button type="button" data-exam-filter={value} aria-pressed={value==='all'?'true':'false'}>{label}<span>{count}</span></button>)}</div><label class="search-field"><Icon name="search"/><input name="q" type="search" data-main-search placeholder="Search titles or objectives…" aria-label="Search tasks"/><kbd>/</kbd></label></div>
  <div class="bank-grid"><aside class="bank-filters" aria-label="Task filters"><fieldset><legend>Domain</legend><select name="domain" aria-label="Objective domain"><option value="all">All domains</option>{(['rhcsa','rhce'] as const).map(exam=><optgroup label={exam.toUpperCase()}>{domains[exam].map(d=><option value={`${exam}.${d.id}`}>{d.title}</option>)}</optgroup>)}</select></fieldset><fieldset><legend>Difficulty</legend>{['easy','medium','hard'].map(level=><label><input type="checkbox" name={`difficulty-${level}`} value={level} checked/>{level[0].toUpperCase()+level.slice(1)}<span>{difficultyCounts[level]}</span></label>)}</fieldset><fieldset><legend>Eligibility</legend><label><input type="checkbox" name="eligibility-eligible" value="eligible" checked/>Exam-eligible<span>{counts.eligible}</span></label><label><input type="checkbox" name="eligibility-practice" value="practice" checked/>Practice-only<span>{counts.practice}</span></label></fieldset><button type="submit" class="btn btn--secondary">Apply filters</button><button type="button" class="text-button" data-clear-filters>Clear filters</button><p>Titles and metadata.<br/>Open a practice session for prompts and solutions.</p><a class="text-link small" href={href('/docs/practice/')}>How practice mode works ↗</a></aside>
    <section class="bank-results" aria-label="Task results"><div class="bank-results-head"><p role="status" aria-live="polite" data-bank-count>{counts.total} of {counts.total} tasks</p><label>Sort <select name="sort" aria-label="Sort tasks"><option value="title">Title A to Z</option><option value="difficulty">Difficulty</option><option value="minutes">Time, shortest first</option><option value="minutes-desc">Time, longest first</option><option value="exam">Exam</option></select></label></div>
    <section class="table-scroll" tabindex="0" aria-label="Task metadata. Scroll horizontally on small screens"><table class="data-table bank-table"><thead><tr><th scope="col">Task</th><th scope="col">Exam</th><th scope="col">Domain</th><th scope="col">Difficulty</th><th scope="col">Time</th><th scope="col">Node</th></tr></thead>{tasks.map(task=><tbody data-task={task.key}><tr><td><details class="bank-task-detail"><summary>{task.title}<Icon name="plus"/></summary><div class="task-objectives"><p class="mono small">Objective lines</p><ul>{task.objectives.map(id=><li>{objectiveText[id]||id}</li>)}</ul>{task.practice_only && <p class="practice-explainer">Available in practice. Excluded from timed exams.</p>}</div></details>{task.practice_only&&<span class="status-chip status-chip--practice">practice-only</span>}</td><td class="mono">{task.exam.toUpperCase()}</td><td>{task.domainTitle}</td><td><span class:list={['status-chip',`status-chip--${task.difficulty}`]}>{task.difficulty}</span></td><td class="mono">{task.estimated_minutes} min</td><td class="mono">{task.node}</td></tr></tbody>)}</table></section>
    <div class="bank-empty" hidden data-bank-empty><h2>No matching tasks.</h2><p>Try a shorter search or clear the filters.</p><button type="button" class="btn btn--secondary" data-clear-filters>Clear filters</button></div><p class="bank-footnote">Filters explore the bank. Timed exams follow their blueprint; practice mode lets you pick up to 10 tasks.</p>
    </section></div>
  </form>
  <noscript><p class="notice">All task titles and objective details are available below. Enable JavaScript to search, filter, sort and share a filtered view.</p></noscript>
  <script type="application/json" id="task-data" set:html={JSON.stringify(tasks.map(task=>({...task,objectiveText:task.objectives.map(id=>objectiveText[id]||id)}))).replace(/</g,'\u003c')}/>
</main>
</Layout>
