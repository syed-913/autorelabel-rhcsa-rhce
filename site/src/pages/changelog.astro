---
import Layout from '../layouts/Layout.astro';
import {markdown,read} from '../lib/content';
import {href,repository} from '../lib/urls';
import FeatureTour from '../components/FeatureTour.astro';
import {features as tours} from '../lib/features';
// The changelog as the repository keeps it: written once per release, read here at build time.
const source=read('CHANGELOG.md').replace(/^# .*\n+(?:(?!## ).*\n+)*/,'');
const {html,headings}=await markdown(source,'CHANGELOG.md');
const versions=headings.filter(heading=>heading.depth===2).map(heading=>{const [version,date]=heading.text.split(/\s+\(/);return {...heading,version,date:(date||'').replace(/\)$/,'')};});
const latest=versions[0];
---
<Layout title="autorelabel changelog: every release" description={`What changed in each release of autorelabel, the free RHCSA and RHCE practice exam for RHEL 10. The latest is ${latest?.version}.`} path="/changelog/">
<main id="content" class="container changelog-page">
  <div class="page-intro"><h1>What changed.<br/><em>Release by release.</em></h1><p>Every version of autorelabel, newest first. Check yours with <code>./autorelabel --version</code> and update with <code>git pull</code>. What comes next is on the <a class="text-link" href={`${repository}/blob/main/ROADMAP.md`}>roadmap ↗</a>.</p></div>
  {tours.map(feature=><FeatureTour feature={feature} compact/>)}
  <div class="changelog-layout">
    <nav class="changelog-versions" aria-label="Versions"><p class="mono small">VERSIONS</p>{versions.map((version,index)=><a class="toc-link" href={`#${version.id}`}><span class="mono">{version.version}</span>{index===0&&<span class="changelog-latest">latest</span>}<small>{version.date}</small></a>)}<a class="text-link small" href={`${repository}/releases`}>Releases on GitHub ↗</a></nav>
    <article class="prose changelog-body" data-pagefind-body set:html={html}/>
  </div>
  <p class="changelog-foot small muted">Versions follow semantic versioning: a patch release only fixes things, a minor release adds something without breaking what you use. The website and the user guide are not versioned. <a class="text-link" href={href('/docs/installing/')}>Installing and updating</a></p>
</main>
</Layout>
