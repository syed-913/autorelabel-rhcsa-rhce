---
import Icon from './Icon.astro';
import {domains,examSources,type Exam} from '../lib/content';
interface Props {exam:Exam;}
const {exam}=Astro.props;
const groups=domains[exam];
---
<section class="coverage-section" id="objectives" data-coverage>
  <div class="section-title"><h2>Every objective.<br/>At least twice.</h2><p>{groups.reduce((sum,d)=>sum+d.objectives.length,0)} objective lines, in Red Hat’s own words. Expand one to see the tasks that practise it.</p></div>
  <label class="search-field"><Icon name="search"/><span class="sr-only">Filter objectives</span><input type="search" data-objective-search placeholder="Find an objective or task…"/></label><p class="small muted" role="status" data-objective-count></p>
  <div class="coverage-domains">{groups.map(domain=><section data-objective-domain><h3>{domain.title}</h3><div class="accordion">{domain.objectives.map(objective=><details id={objective.id} data-objective data-search={`${objective.text} ${objective.tasks.map(t=>t.title).join(' ')}`.toLowerCase()}><summary><span><span class="check-mark">✔</span> {objective.text}</span><span class="objective-count">{objective.tasks.length} tasks <Icon name="plus"/></span></summary><div class="answer"><ul>{objective.tasks.map(task=><li>{task.title}{task.practice_only && <span class="status-chip status-chip--practice">practice-only</span>}</li>)}</ul></div></details>)}</div></section>)}</div>
  <p data-objective-empty hidden>No matching objectives. Clear the search to see every line.</p>
  <p class="small muted">Coverage includes practice-only tasks. <a class="text-link" href={examSources[exam]}>Read the official {exam==='rhcsa'?'EX200':'EX294'} objectives ↗</a></p>
</section>
