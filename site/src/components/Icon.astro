---
interface Props { name: string; class?: string; }
const {name,class:className=''}=Astro.props;
const paths: Record<string,string>={
  arrow:'<path d="M5 12h14m-6-6 6 6-6 6"/>',
  copy:'<rect x="8" y="8" width="12" height="12" rx="1"/><path d="M16 8V4H4v12h4"/>',
  theme:'<path d="M8 4a8 8 0 1 0 12 9M8 4a7 7 0 0 0 12 9M8 4H3m5 0v5"/>',
  menu:'<path d="M4 7h16M4 12h16M4 17h16"/>',
  close:'<path d="m6 6 12 12M6 18 18 6"/>',
  reboot:'<path d="M4 10a8 8 0 1 1 1 7M4 10V4m0 6h6M8 12l3 3 5-6"/>',
  search:'<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>',
  plus:'<path d="M5 12h14M12 5v14"/>',
  check:'<path d="m4 12 5 5L20 6"/>',
  play:'<path d="m9 5 11 7-11 7Z"/>',
  pause:'<path d="M8 5v14M16 5v14"/>',
};
---
<svg class:list={['icon',className]} viewBox="0 0 24 24" aria-hidden="true" set:html={paths[name] || paths.arrow}/>
