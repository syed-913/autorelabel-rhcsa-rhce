---
import Icon from './Icon.astro';
import {href,repository} from '../lib/urls';
const links=[['Get started','/start/'],['RHCSA','/rhcsa/'],['RHCE','/rhce/'],['Tasks','/tasks/'],['How it works','/how-it-works/'],['Docs','/docs/'],['FAQ','/faq/']];
---
<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header" transition:persist="site-header" data-pagefind-ignore="all">
  <div class="container site-header__inner">
    <a class="brand" href={href('/')} aria-label="autorelabel Home">
      <img class="brand__paper" src={href('/brand/wordmark-mono-on-paper.svg')} width="194" height="46" alt="autorelabel"/>
      <img class="brand__night" src={href('/brand/wordmark-mono-on-night.svg')} width="194" height="46" alt="autorelabel"/>
    </a>
    <nav class="primary-nav" aria-label="Main navigation">
      {links.map(([label,path])=><a class:list={['nav-link',{'nav-link--start':label==='Get started'}]} href={href(path)} data-cursor="open" aria-current={Astro.url.pathname.startsWith(href(path))?'page':undefined}>{label}</a>)}
    </nav>
    <div class="header-tools">
      <a class="header-github text-link" href={repository} data-cursor="GitHub ↗">GitHub ↗</a>
      <button type="button" class="icon-button" data-open-search aria-label="Search Docs and FAQ"><Icon name="search"/></button>
      <button type="button" class="icon-button theme-button" data-theme-toggle aria-label="Switch theme"><Icon name="theme"/></button>
      <button type="button" class="icon-button menu-trigger" data-open-menu aria-label="Open navigation menu" aria-controls="site-menu" aria-expanded="false"><Icon name="menu"/></button>
    </div>
  </div>
</header>
<noscript><nav class="container no-script-nav" aria-label="Main navigation without scripts">{links.map(([label,path])=><a class="text-link" href={href(path)}>{label}</a>)}</nav></noscript>
