---
import {ClientRouter} from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dialogs from '../components/Dialogs.astro';
import {href,canonical} from '../lib/urls';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/system.css';
import '../styles/pages.css';
interface Props {title:string;description:string;path?:string;schema?:Record<string,unknown>;noindex?:boolean;}
const {title,description,path='/',schema,noindex=false}=Astro.props;
const pageTitle=path==='/'?`autorelabel · ${title}`:`${title} · autorelabel`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta http-equiv="x-dns-prefetch-control" content="off"/>
    <title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical(path)}/>
    {noindex && <meta name="robots" content="noindex"/>}
    {path==='/' && <meta name="google-site-verification" content="sPlu1Ci1LEuEz5G96-e0RFxuKyZuYPIDG-L9BQCC36E"/>}
    <meta property="og:type" content="website"/><meta property="og:site_name" content="autorelabel"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical(path)}/><meta property="og:image" content={canonical('/social-preview.png')}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="autorelabel: RHCSA and RHCE practice exams, graded after a reboot"/>
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={canonical('/social-preview.png')}/>
    <meta name="theme-color" content="#F3EEE4"/><link rel="icon" type="image/svg+xml" href={href('/brand/icon-slashdot.svg')}/><link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')}/><link rel="apple-touch-icon" sizes="180x180" href={href('/apple-touch-icon.png')}/><link rel="manifest" href={href('/manifest.webmanifest')}/>
    <link rel="preload" href={href('/fonts/fraunces-headline-normal.woff2')} as="font" type="font/woff2" crossorigin="anonymous"/>
    {path==='/' && <link rel="preload" href={href('/fonts/fraunces-headline-italic.woff2')} as="font" type="font/woff2" crossorigin="anonymous"/>}
    <link rel="preload" href={href('/fonts/atkinson-hyperlegible-next-latin-400-normal.woff2')} as="font" type="font/woff2" crossorigin="anonymous"/>
    <script is:inline>try{const t=localStorage.getItem('autorelabel-theme');if(t==='night'||t==='paper')document.documentElement.dataset.theme=t;}catch{}</script>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')}/>}
    <ClientRouter/>
  </head>
  <body data-base={href('/')}>
    <Header/>
    <slot/>
    <Footer/>
    <Dialogs/>
    <div class="toast-stack" role="status" aria-live="polite" aria-atomic="true" data-toast data-pagefind-ignore="all"></div>
    <div class="cursor-ring" data-cursor-ring aria-hidden="true"></div><div class="cursor-dot" data-cursor-dot aria-hidden="true"></div>
    <div class="relabel-scan" aria-hidden="true" data-relabel-scan></div>
    <script>import '../scripts/runtime';</script>
  </body>
</html>
