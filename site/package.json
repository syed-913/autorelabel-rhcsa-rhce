{
  "name": "autorelabel-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 ASTRO_DEV_BACKGROUND=0 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist --glob \"{docs/**/*.html,faq/index.html}\"",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 ASTRO_PREVIEW_BACKGROUND=0 astro preview --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "verify": "node scripts/verify-build.mjs",
    "check:html": "html-validate \"dist/**/*.html\"",
    "review:browser": "node scripts/review-browser.mjs",
    "review:interactions": "node scripts/review-interactions.mjs",
    "review:states": "node scripts/review-states.mjs",
    "check:deps": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "js-yaml": "4.3.2",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "smol-toml": "1.9.1",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.19.3",
    "axe-core": "4.14.0",
    "html-validate": "10.17.0",
    "lighthouse": "13.5.0",
    "pagefind": "1.5.2",
    "typescript": "5.9.3"
  }
}
